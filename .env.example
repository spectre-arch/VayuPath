# ==============================================================================
# VayuPath Environment Variables Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. OFFICIAL DATA SOURCE KEYS (Real Free India Data)
# Note: If keys are missing, VayuPath uses free Open-Meteo & NASA open feeds
# with explicit transparent source labelling. Never dummy values!
# ------------------------------------------------------------------------------
# Central Pollution Control Board (CPCB) data.gov.in API Key:
# Register at: https://data.gov.in/user/register
DATAGOVIN_API_KEY=
DATAGOVIN_RESOURCE_ID=3b01bcb8-0b14-4abf-b6f2-c1bfd384ba69

# OpenAQ v3 API Key (Fallback 1):
# Register at: https://openaq.org
OPENAQ_API_KEY=

# World Air Quality Index (WAQI) Token (Fallback 2):
# Register at: https://aqicn.org/data-platform/token/
WAQI_API_KEY=

# NASA FIRMS Active Fire Map Key:
# Register at: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# ------------------------------------------------------------------------------
# 2. AWS PRODUCTION & LOCALSTACK CONFIGURATION
# ------------------------------------------------------------------------------
AWS_REGION=ap-south-1
AWS_DEFAULT_REGION=ap-south-1
STAGE=dev

# Amazon Bedrock Model for Strands Agents SDK
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Set this to run locally against LocalStack without an AWS Account:
# LOCALSTACK_ENDPOINT_URL=http://localhost:4566

# SNS Topic for Health & School Alerts:
SNS_ALERTS_TOPIC_ARN=arn:aws:sns:ap-south-1:123456789012:vayupath-alerts-topic-dev

# ------------------------------------------------------------------------------
# 3. FRONTEND CONFIGURATION (React + Vite)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5001
VITE_APP_NAME="VayuPath वायुपथ"
